# Database (PostgreSQL)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated user ids that are treated as super admins
BETTER_AUTH_ADMIN_USER_IDS=

# Server
PORT=3000
HOST=127.0.0.1
# Public base URL used to build uploaded file links (defaults to BETTER_AUTH_URL / localhost)
PUBLIC_API_URL=
# Comma-separated list of allowed frontend origins (CORS + trusted origins)
FRONTEND_ORIGINS=http://localhost:5173

# Social OAuth providers — leave empty to disable a provider.
# Callback URL pattern: <BETTER_AUTH_URL>/api/auth/callback/<provider>
# Discord allows http://localhost; VK ID requires HTTPS (use ngrok / cloudflared tunnel in dev).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email delivery. Use console locally and smtp on the deployed server.
EMAIL_TRANSPORT=console
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1127
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender domain must be connected to the SMTP service.
EMAIL_FROM="RF4 Community <no-reply@example.com>"
# Optional address for user replies.
EMAIL_REPLY_TO=
